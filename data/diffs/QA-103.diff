@@ -4,12 +4,21 @@ from app.models import Order

 FLAT_SHIPPING = 5.00
 FREE_SHIPPING_THRESHOLD = 100.00
+BULK_DISCOUNT_MIN_ITEMS = 5
+BULK_DISCOUNT_RATE = 0.10


 def subtotal(order: Order) -> float:
     return sum(item.unit_price * item.quantity for item in order.items)


+def discounted_subtotal(order: Order) -> float:
+    base = subtotal(order)
+    if order.item_count >= BULK_DISCOUNT_MIN_ITEMS:
+        base = base * (1 - BULK_DISCOUNT_RATE)
+    return int(base * 100) / 100
+
+
 def shipping_fee(order: Order) -> float:
     if subtotal(order) >= FREE_SHIPPING_THRESHOLD:
         return 0.00
