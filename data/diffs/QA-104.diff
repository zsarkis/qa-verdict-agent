@@ -22,3 +26,13 @@ def create_order(payload: dict) -> dict:
     order = Order(id=payload["id"], customer=Customer(**payload["customer"]))
     ORDERS[order.id] = order
     return {"id": order.id, "total": order_total(order)}
+
+
+def archive_stale_orders(params: dict) -> dict:
+    cutoff = datetime.utcnow() - timedelta(days=RETENTION_DAYS)
+    archived = []
+    for order in ORDERS.values():
+        if order.status == "open" and order.created_at < cutoff:
+            order.status = "archived"
+            archived.append(order.id)
+    return {"archived": archived, "count": len(archived)}
