+++ b/tests/test_archive.py
@@ -0,0 +1,18 @@
+from datetime import datetime, timedelta
+
+from app.api import archive_stale_orders, list_orders
+from app.models import Customer, Order
+from app.store import ORDERS
+
+
+def test_archived_orders_leave_the_default_listing():
+    ORDERS.clear()
+    customer = Customer(id="c1", name="Test", email="t@example.com")
+    old = Order(id="old", customer=customer)
+    old.created_at = datetime.utcnow() - timedelta(days=400)
+    fresh = Order(id="fresh", customer=customer)
+    ORDERS.update({"old": old, "fresh": fresh})
+
+    result = archive_stale_orders({})
+    assert result["archived"] == ["old"]
+    assert list_orders({})["orders"] == ["fresh"]
