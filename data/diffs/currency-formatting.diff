+export const dollars = (cents: number) => {
+  const sign = cents < 0 ? '-' : ''
+  const amount = (Math.abs(cents) / 100).toLocaleString('en-US', {
+    minimumFractionDigits: 2, maximumFractionDigits: 2,
+  })
+  return `${sign}$${amount}`
+}
 
