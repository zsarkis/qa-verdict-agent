+from app.models import LineItem
+
+
+def test_gift_wrap_defaults_false():
+    item = LineItem("SKU-1", "Widget", 10.00, 1)
+    assert item.gift_wrap is False
+
+
+def test_gift_wrap_can_be_set():
+    item = LineItem("SKU-1", "Widget", 10.00, 1, gift_wrap=True)
+    assert item.gift_wrap is True
