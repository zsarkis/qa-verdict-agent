@@ -0,0 +1,28 @@
+from app.models import Customer, LineItem, Order
+from app.orders import order_total
+
+
+def make_order(*items):
+    customer = Customer(id="c1", name="Test Customer", email="test@example.com")
+    return Order(id="o1", customer=customer, items=list(items))
+
+
+def test_promo_discounts_subtotal_before_shipping():
+    order = make_order(LineItem("SKU-1", "Widget", 50.00, 1))
+    # 50.00 - 20% = 40.00, below threshold, + 5.00 shipping
+    assert order_total(order, {"code": "SAVE20", "percent_off": 20}) == 45.00
+
+
+def test_threshold_applies_to_discounted_subtotal():
+    order = make_order(LineItem("SKU-1", "Widget", 110.00, 1))
+    # 110.00 - 20% = 88.00 -> discounted amount is below 100, shipping now applies
+    assert order_total(order, {"code": "SAVE20", "percent_off": 20}) == 93.00
+
+
+def test_no_promo_keeps_existing_totals():
+    order = make_order(LineItem("SKU-1", "Widget", 10.00, 1))
+    assert order_total(order) == 15.00
+
+
+def test_free_shipping_still_free_without_promo():
+    order = make_order(LineItem("SKU-1", "Widget", 100.00, 1))
+    assert order_total(order) == 100.00
