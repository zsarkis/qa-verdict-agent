-        return 0.00
-    return FLAT_SHIPPING
+def apply_promo(amount: float, promo: dict | None) -> float:
+    """Apply a percentage promo to a merchandise amount."""
+    if not promo:
+        return amount
+    percent = float(promo.get("percent_off", 0))
+    return round(amount * (1 - percent / 100), 2)


-def order_total(order: Order) -> float:
-    return subtotal(order) + shipping_fee(order)
+def shipping_fee_for(amount: float) -> float:
+    """Shipping owed on a given merchandise amount."""
+    if amount >= FREE_SHIPPING_THRESHOLD:
+        return 0.00
+    return FLAT_SHIPPING
+
+
+def shipping_fee(order: Order) -> float:
+    # Kept for existing callers: shipping on the undiscounted subtotal.
+    return shipping_fee_for(subtotal(order))
+
+
+def order_total(order: Order, promo: dict | None = None) -> float:
+    discounted = apply_promo(subtotal(order), promo)
+    return discounted + shipping_fee_for(discounted)
diff --git a/tests/test_promo.py b/tests/test_promo.py
