+++ b/tests/test_api.py
@@ -0,0 +1,29 @@
+from app.api import list_orders
+from app.models import Customer, Order
+from app.store import ORDERS
+
+
+def seed(n):
+    ORDERS.clear()
+    customer = Customer(id="c1", name="Test", email="t@example.com")
+    for i in range(n):
+        ORDERS[f"o{i}"] = Order(id=f"o{i}", customer=customer)
+
+
+def test_default_page_is_20():
+    seed(25)
+    result = list_orders({})
+    assert result["count"] == 20
+    assert result["total_count"] == 25
+
+
+def test_offset_returns_remainder():
+    seed(25)
+    result = list_orders({"limit": 20, "offset": 20})
+    assert result["orders"] == [f"o{i}" for i in range(20, 25)]
+    assert result["total_count"] == 25
+
+
+def test_archived_orders_excluded_from_total():
+    seed(3)
+    ORDERS["o0"].status = "archived"
+    assert list_orders({})["total_count"] == 2
