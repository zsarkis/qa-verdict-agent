+++ b/tests/test_create_order.py
@@ -0,0 +1,18 @@
+from app.api import create_order
+from app.store import ORDERS
+
+
+def test_created_order_carries_items_and_total():
+    ORDERS.clear()
+    result = create_order({
+        "id": "o1",
+        "customer": {"id": "c1", "name": "Test", "email": "t@example.com"},
+        "items": [
+            {"sku": "SKU-1", "description": "Widget", "unit_price": 10.00, "quantity": 3},
+        ],
+    })
+    assert ORDERS["o1"].item_count == 3
+    # 30.00 merchandise + 5.00 flat shipping (below free-shipping threshold)
+    assert result["total"] == 35.00
