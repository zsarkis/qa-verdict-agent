--- /dev/null
+++ b/tests/test_bulk_shipping.py
@@ -0,0 +1,16 @@
+from app.models import Customer, LineItem, Order
+from app.orders import shipping_fee
+
+
+def make_order(*items):
+    customer = Customer(id="c1", name="Test Customer", email="test@example.com")
+    return Order(id="o1", customer=customer, items=list(items))
+
+
+def test_bulk_orders_ship_free():
+    order = make_order(LineItem("SKU-1", "Widget", 2.00, 12))
+    assert shipping_fee(order) == 0.00
+
+
+def test_small_cheap_orders_still_pay_shipping():
+    order = make_order(LineItem("SKU-1", "Widget", 2.00, 3))
+    assert shipping_fee(order) == 5.00
