# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- LangSmith tracing ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=qa-verdict-agent

# --- Board backend ---
# file (default): JSON fixtures in data/tickets, verdicts to data/board/outbox.
# github: real GitHub Issues — ticket id = issue number, verdict posts as a
# comment. Needs QA_BOARD_REPO and GITHUB_TOKEN (gh auth token works).
QA_BOARD=file
QA_BOARD_REPO=
GITHUB_TOKEN=
# Root the review tool (get_file_context) reads from; empty = the fixture app.
# Point at a real checkout to review live tickets against real code.
QA_REPO_DIR=

# --- Model selection (init_chat_model "provider:model" strings) ---
# Review/verdict model (Claude), judge model (cross-family: GPT judges Claude),
# embeddings for the KB retriever.
QA_REVIEW_MODEL=anthropic:claude-sonnet-4-6
QA_JUDGE_MODEL=openai:gpt-5.5
QA_EMBEDDINGS_MODEL=text-embedding-3-small
